PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
JWT_SECRET=change-me

DATABASE_URL=postgres://postgres:postgres@localhost:5432/email_scheduler
REDIS_URL=redis://localhost:6379
# leave empty to fall back to a plain DB search
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# how many Ethereal sender accounts to auto-create on first boot
ETHEREAL_SENDER_COUNT=3

WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
JOB_ATTEMPTS=3

# set to true to run the worker inside the API process (single service deploys)
RUN_WORKER=false

# basic auth for /admin/queues (optional)
ADMIN_USER=admin
ADMIN_PASSWORD=admin
